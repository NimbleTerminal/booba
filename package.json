{
  "name": "@nimbleterminal/booba",
  "version": "0.13.0",
  "type": "module",
  "description": "Terminal wrapper for BubbleTea programs using ntwebterm",
  "main": "dist/booba.js",
  "module": "dist/booba.js",
  "types": "dist/booba.d.ts",
  "exports": {
    ".": {
      "types": "./dist/booba.d.ts",
      "import": "./dist/booba.js"
    },
    "./ghostty-vt.wasm": "./dist/ntwebterm/ghostty-vt.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-npm.mjs",
    "build:embed": "tsc -p tsconfig.embed.json && sed -i.bak -e \"s|from 'ntwebterm'|from '../ntwebterm/ntwebterm.js'|\" serve/static/booba/*.js && rm serve/static/booba/*.js.bak",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "test:package": "node scripts/test-npm-package.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleTerminal/booba.git"
  },
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "ntwebterm": "file:third_party/ntwebterm",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.74"
  }
}
